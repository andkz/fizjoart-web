<section class="py-16 md:py-24 bg-[#fafafa] border-t border-[#eeeeee]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      <!-- Karta 1: Zapisz się -->
      <div class="bg-white p-8 md:p-12 rounded-2xl border border-[#e5e5e5] shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-brand-green">
            Fizjoterapia w Zielonej Górze
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#0a0a0a] mt-3 mb-4 leading-tight">
            Zaczynam od rozmowy, wywiadu i badania.
          </h2>
          <p class="text-[#737373] text-base leading-relaxed mb-8">
            W gabinecie łączę precyzję fizjoterapii z głębokim wyciszeniem układu nerwowego. Odzyskaj pełną swobodę ruchu i spokój ciała.
          </p>
        </div>
        <div>
          <a
            href="/kontakt"
            class="inline-flex items-center justify-center px-6 py-3.5 text-[15px] font-medium text-white bg-brand-green hover:bg-brand-green-light rounded-lg shadow-sm hover:shadow transition-all duration-150 active:scale-[0.98]"
          >
            Umów wizytę
          </a>
        </div>
      </div>

      <!-- Karta 2: Gabinet i lokalizacja -->
      <div class="bg-white p-8 md:p-12 rounded-2xl border border-[#e5e5e5] shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-[#737373]">
            Gdzie Przyjmuję
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-[#0a0a0a] mt-3 mb-4 leading-tight">
            Gdzie Mnie znajdziesz?
          </h2>
          <p class="text-[#737373] text-base leading-relaxed mb-6">
            Prywatny, komfortowy gabinet fizjoterapii i terapii czaszkowo-krzyżowej w Zielonej Górze.
          </p>
          <div class="flex items-start gap-3 text-[#0a0a0a] font-medium text-lg">
            <svg class="w-6 h-6 text-brand-green flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Anieli Krzywoń 16, 65-534 Zielona Góra</span>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-[#f0f0f0] flex flex-wrap items-center gap-6 text-sm text-[#737373]">
          <a href="tel:+48663307553" class="hover:text-brand-green transition-colors font-medium">
            📞 +48 663 307 553
          </a>
          <a href="mailto:artur.baniaa@gmail.com" class="hover:text-brand-green transition-colors font-medium">
            ✉️ artur.baniaa@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
