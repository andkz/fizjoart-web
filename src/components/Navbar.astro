---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/o-mnie', label: 'O mnie' },
  { href: '/cennik', label: 'Cennik' },
  { href: '/blog', label: 'Blog' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/85 backdrop-blur-md border-b border-[#eeeeee] transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="font-serif text-2xl font-bold tracking-tight text-[#0a0a0a] group-hover:text-brand-green transition-colors">
        FizjoArt
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-brand-green"></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`text-[15px] font-medium tracking-tight transition-colors duration-150 ${
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'text-brand-green font-semibold'
              : 'text-[#0a0a0a] hover:text-brand-green'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA Button -->
    <div class="hidden md:flex items-center">
      <a
        href="/kontakt"
        class="inline-flex items-center justify-center px-5 py-2.5 text-[15px] font-medium text-white bg-brand-green hover:bg-brand-green-light rounded-lg shadow-sm hover:shadow transition-all duration-150 active:scale-[0.98]"
      >
        Umów Wizytę
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-[#0a0a0a] hover:text-brand-green hover:bg-[#f5f5f5] focus:outline-none"
      aria-label="Otwórz menu nawigacji"
      aria-expanded="false"
    >
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#eeeeee] bg-white px-4 pt-2 pb-6 space-y-3">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block py-2 text-base font-medium transition-colors ${
          currentPath === link.href ? 'text-brand-green font-semibold' : 'text-[#0a0a0a] hover:text-brand-green'
        }`}
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2">
      <a
        href="/kontakt"
        class="block w-full text-center px-5 py-3 text-base font-medium text-white bg-brand-green hover:bg-brand-green-light rounded-lg shadow-sm transition-all"
      >
        Umów Wizytę
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && hamIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      hamIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
