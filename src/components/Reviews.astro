---
const reviews = [
  {
    author: 'Justyna',
    text: 'Polecam Pana Artura :) w gabinecie czułam się zaopiekowana, wszystkie ćwiczenia zostały pokazane i omówione - miałam dokładnie wyjaśnione co się dzieje z ciałem w trakcie ćwiczeń. Dziękuję za pomoc'
  },
  {
    author: 'Jacek',
    text: 'Polecam, jestem bardzo zadowolony z wizyty. Serdeczne podejście do pacjenta, wszystko dokładnie wyjaśniane, pełen profesjonalizm.'
  },
  {
    author: 'Agata',
    text: 'Świetny fizjoterapeuta z ogromną pasją do tego co robi! Artur to osoba z masą wiedzy, profesjonalizmu i serca do pacjenta. Efekty terapii są świetne, a atmosfera podczas wizyt motywuje do pracy nad sobą. Polecam z całego serca!'
  },
  {
    author: 'Karolina',
    text: 'Trafiłam do p. Artura w celu rehabilitacji po szyciu łąkotki oraz rekonstrukcji ACL. Jestem bardzo zadowolona z efektów naszej pracy. Wiedza, zaangażowanie, szczegółowe wyjaśnienia, cierpliwość i wszechstronność (terapia manualna, igły, ćwiczenia) zasłużyły na 5 gwiazdek. Rekomenduję i polecam!'
  },
  {
    author: 'Janina',
    text: 'Pan Artur to znakomity specjalista w swojej dziedzinie. Po serii wizyt wróciłam do pełnej sprawności (ból kręgosłupa szyjnego z promieniowaniem do ręki i mrowieniem palców). Serdecznie pozdrawiam i polecam.'
  },
  {
    author: 'Sławek',
    text: 'Bardzo mi pomogła wizyta u tego fizjoterapeuty, zakres ruchu w barku poprawił się prawie 100%.'
  },
  {
    author: 'Kamil',
    text: 'Polecam Pana Artura za podejście i super wyjaśnienie. Jeśli ktoś ma wątpliwości co do tego fizjoterapeuty to z całego serducha polecam. Jedna wizyta a cenne wskazówki :)'
  },
  {
    author: 'Ewa',
    text: 'Bardzo polecam pana Artura. Osoba bardzo empatyczna i wzbudzająca zaufanie. Mogę zarekomendować profesjonalne wsparcie pana Artura w imieniu własnym oraz grupy mam niepełnosprawnych podopiecznych stowarzyszenia, gdzie pan Artur dbał o ich dobrą kondycję i dobrostan.'
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {reviews.map((r) => (
    <div class="bg-white p-7 rounded-2xl border border-[#e5e5e5] shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between">
      <div>
        <!-- Stars rating -->
        <div class="flex items-center gap-1 text-[#004727] mb-4">
          {[...Array(5)].map(() => (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <p class="text-[#404040] text-[15px] leading-relaxed mb-6 italic">
          "{r.text}"
        </p>
      </div>
      <div class="pt-4 border-t border-[#f5f5f5] flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-brand-green/10 text-brand-green font-semibold flex items-center justify-center text-sm">
          {r.author[0]}
        </div>
        <div>
          <h4 class="font-medium text-[#0a0a0a] text-sm">{r.author}</h4>
          <span class="text-xs text-[#737373]">Zweryfikowany pacjent</span>
        </div>
      </div>
    </div>
  ))}
</div>
