---
const faqs = [
  {
    q: 'Czym się zajmuję?',
    a: 'Jestem fizjoterapeutą. Pracuję z bólem i napięciem w ciele. Specjalizuję się w terapii czaszkowo-krzyżowej.'
  },
  {
    q: 'Jak wygląda pierwsza wizyta?',
    a: 'Zaczynam od rozmowy, wywiadu i badania. Chcę zrozumieć, z czym przychodzisz i jak wygląda Twoja sytuacja.'
  },
  {
    q: 'Dla kogo jest wizyta?',
    a: 'Przyjmuję pacjentów w każdym wieku. Pracuję także z dziećmi i młodzieżą.'
  },
  {
    q: 'Z jakimi dolegliwościami można się zgłosić?',
    a: 'Możesz zgłosić się m.in. z bólem kręgosłupa, rwą kulszową, dyskopatią, bólem głowy, migreną, bólem stawów, stanem pourazowym lub pooperacyjnym.'
  },
  {
    q: 'Czym jest terapia czaszkowo-krzyżowa?',
    a: 'To subtelna forma pracy z ciałem, wywodząca się z osteopatii. Wykorzystuję ją m.in. w pracy z bólem, napięciem, stresem i przewlekłym zmęczeniem.'
  },
  {
    q: 'Czy pracujesz z dziećmi i młodzieżą?',
    a: 'Tak. Od lat pracuję z dziećmi i młodzieżą. Obecnie jestem fizjoterapeutą reprezentacji Polski WU-17.'
  },
  {
    q: 'Gdzie odbywają się wizyty?',
    a: 'Przyjmuję w prywatnym gabinecie w Zielonej Górze przy ul. Anieli Krzywoń 16.'
  },
  {
    q: 'Jak dobierasz terapię?',
    a: 'Dobieram ją indywidualnie, po rozmowie, wywiadzie i badaniu.'
  }
];
---

<div class="space-y-4 max-w-3xl mx-auto">
  {faqs.map((faq, index) => (
    <details
      class="group border border-[#e5e5e5] rounded-xl bg-white p-5 sm:p-6 transition-all duration-200 hover:border-brand-green/40 open:border-brand-green/60 open:shadow-sm"
      open={index === 0}
    >
      <summary class="flex items-center justify-between cursor-pointer list-none select-none">
        <h3 class="text-lg font-medium text-[#0a0a0a] group-hover:text-brand-green transition-colors pr-4">
          {faq.q}
        </h3>
        <span class="w-8 h-8 rounded-full bg-[#f5f5f5] flex items-center justify-center flex-shrink-0 text-[#737373] group-hover:bg-brand-green/10 group-hover:text-brand-green transition-all duration-200 group-open:rotate-180">
          <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <div class="mt-4 pt-4 border-t border-[#f0f0f0] text-[#737373] leading-relaxed text-[15px]">
        {faq.a}
      </div>
    </details>
  ))}
</div>
